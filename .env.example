# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Groq API (LLM orchestrator, Phase 6)
GROQ_API_KEY=

# PubMed E-utilities (evidence retrieval, Phase 5)
# Email is required by NCBI's usage policy for E-utilities requests.
NCBI_EMAIL=
# Optional but recommended: raises rate limit from 3 to 10 req/sec. Free to generate
# from your NCBI account settings > API Key Management.
NCBI_API_KEY=

# MLflow (leave blank to use local ./mlruns folder)
MLFLOW_TRACKING_URI=
